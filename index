<!doctype html>
<html lang="uz">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Falsafa Akademiyasi — Tafakkur sari bepul yo‘l</title>
<meta name="description" content="Bepul falsafa kursi. Donishmandlar fikri, qiziqarli darslar, bilim sinovlari va elektron sertifikat. 1–3 oyda tafakkuringizni charxlang.">
<meta name="keywords" content="falsafa, falsafa kursi, bepul ta'lim, Sokrat, Aristotel, tafakkur, falsafa darslari">
<meta property="og:title" content="Falsafa Akademiyasi"><meta property="og:description" content="Savol berishdan boshlanadigan bepul falsafa sayohati.">
<meta name="theme-color" content="#111d2d">
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--navy:#111d2d;--cream:#f5f0e6;--gold:#c59a52;--ink:#172337;--muted:#697386}*{box-sizing:border-box}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif}header{background:var(--navy);color:white;padding:22px max(6vw,22px);display:flex;justify-content:space-between;align-items:center;gap:20px}.brand{font-family:'Playfair Display',serif;font-size:21px}.brand span{color:var(--gold)}nav a{color:#e8e5df;text-decoration:none;margin-left:22px;font-size:13px}.hero{background:radial-gradient(ellipse at 80% 20%,#34435a 0,#111d2d 55%);color:white;padding:90px max(8vw,24px) 100px;position:relative;overflow:hidden}.hero:after{content:"“";position:absolute;right:10%;top:-100px;font:360px Georgia;color:#ffffff0d}.eyebrow{color:#e0bd7e;letter-spacing:3px;text-transform:uppercase;font-size:11px}.hero h1{font:clamp(42px,6vw,76px)/1.08 'Playfair Display',serif;max-width:760px;margin:20px 0}.hero p{color:#c6ced8;max-width:580px;line-height:1.8}.btn{border:0;border-radius:3px;padding:14px 22px;background:var(--gold);color:#111d2d;font-weight:700;cursor:pointer;text-decoration:none;display:inline-block;margin-top:16px}.wrap{max-width:1100px;margin:auto;padding:70px 24px}.section-title{font:36px 'Playfair Display',serif;margin:0 0 12px}.sub{color:var(--muted);line-height:1.7}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}.card{background:#fffdf8;padding:25px;border:1px solid #e8dfd0;border-radius:5px}.card .num{color:var(--gold);font:30px 'Playfair Display'}.card h3{font:21px 'Playfair Display';margin:10px 0}.card p{color:var(--muted);line-height:1.65;font-size:14px}.panel{background:#fffdf8;padding:30px;border:1px solid #e6ddcf;border-radius:5px;max-width:760px;margin:30px auto}.field{display:grid;gap:7px;margin:14px 0}.field label{font-size:13px;font-weight:700}.field input,.field select{padding:13px;border:1px solid #d8d0c4;background:white;border-radius:3px;font:inherit;width:100%}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.notice{padding:14px;background:#f5f0e6;border-left:3px solid var(--gold);line-height:1.6;margin:18px 0}.lesson{border-top:1px solid #e7dfd3;padding:18px 0}.lesson h3{font:22px 'Playfair Display';margin:4px 0 8px}.lesson p{line-height:1.8;color:#4e5969}.quiz{background:#f4efe5;padding:16px;margin:15px 0}.quiz label{display:block;margin:10px 0}.hidden{display:none!important}.status{margin:15px 0;padding:13px;background:#eaf2e9;color:#24522b;border-radius:3px}.error{background:#f8e9e6;color:#8b2d22}.progress{height:7px;background:#e7dfd3;margin:18px 0}.progress span{display:block;height:100%;background:var(--gold);width:0}footer{background:var(--navy);color:#aeb8c6;text-align:center;padding:45px 20px;font-size:12px}footer .founder{font-size:10px;opacity:.65;margin-top:35px}button:disabled{opacity:.5;cursor:not-allowed}@media(max-width:700px){header{align-items:flex-start;flex-direction:column}nav a{margin:0 15px 0 0}.cards{grid-template-columns:1fr}.row{grid-template-columns:1fr}.hero{padding-top:65px}}
</style></head>
<body>
<header><div class="brand">FALSAFA <span>AKADEMIYASI</span></div><nav><a href="#about">Akademiya</a><a href="#program">Dastur</a><a href="#join">Ro‘yxatdan o‘tish</a></nav></header>
<section class="hero"><div class="eyebrow">Bepul ta’lim • 1–3 oy • Sertifikat</div><h1>Fikrlaringizga qanot bering. Dunyoqarashingizga ufq.</h1><p>Bu yerda tayyor javoblarni yodlamaysiz. Siz savol berishni, dalil izlashni va hayotga teran nigoh bilan qarashni o‘rganasiz. Buyuk mutafakkirlar bilan fikriy sayohatni bugun boshlang.</p><a class="btn" href="#join">Sayohatni boshlash →</a></section>
<section class="wrap" id="about"><div class="eyebrow">Bizning qarashimiz</div><h2 class="section-title">Donolik — savol berishga jur’at topishdir.</h2><p class="sub">Falsafa murakkab so‘zlar musobaqasi emas. U kundalik hayotdagi tanlovlarimiz, adolat, baxt, haqiqat va o‘zligimiz haqida aniqroq fikrlash san’atidir. Darslar sodda til, hayotiy misollar va kichik mashqlar bilan tuzilgan.</p><div class="cards"><article class="card"><div class="num">01</div><h3>Oddiy va chuqur</h3><p>Har bir tushuncha sodda izoh, misol va qisqa xulosa bilan beriladi.</p></article><article class="card"><div class="num">02</div><h3>Faol tafakkur</h3><p>Har darsda savol, mulohaza va bilimni tekshiruvchi kichik sinov bor.</p></article><article class="card"><div class="num">03</div><h3>Natijangiz e’tirof etiladi</h3><p>6 darsni tugatib, emailingizni tasdiqlasangiz, PDF sertifikat olasiz.</p></article></div></section>
<section class="wrap" id="program"><div class="eyebrow">O‘quv dasturi</div><h2 class="section-title">Olti qadamda tafakkur sayohati</h2><p class="sub">Har dars taxminan 15–25 daqiqa. Darslarni o‘z sur’atingizda o‘ting.</p><div class="cards">
<article class="card"><div class="num">I</div><h3>Sokrat: o‘zingni angla</h3><p>Savol berish usuli va o‘z fikringizni tekshirish.</p></article>
<article class="card"><div class="num">II</div><h3>Aflotun: haqiqat soyasi</h3><p>Ko‘rinish va haqiqat o‘rtasidagi farq.</p></article>
<article class="card"><div class="num">III</div><h3>Aristotel: yaxshi hayot</h3><p>Fazilat, odat va muvozanat haqida.</p></article>
<article class="card"><div class="num">IV</div><h3>Forobiy: fozil jamiyat</h3><p>Adolat, hamkorlik va umumiy farovonlik.</p></article>
<article class="card"><div class="num">V</div><h3>Beruniy: dalil kuchi</h3><p>Qiziquvchanlik, kuzatish va xolis fikrlash.</p></article>
<article class="card"><div class="num">VI</div><h3>Seneka: vaqt va xotirjamlik</h3><p>Vaqtni qadrlash va nazoratimizdagi narsalarni anglash.</p></article></div></section>
<section class="wrap" id="join"><div class="eyebrow">Birinchi qadam</div><h2 class="section-title">Akademiyaga qo‘shiling</h2><p class="sub">Ta’lim mutlaqo bepul. Avval ism, familiya va telefon raqamingiz so‘raladi. Email sertifikat bosqichida kerak bo‘ladi.</p>
<div class="panel" id="registerPanel"><form id="registerForm"><div class="row"><div class="field"><label for="first">Ism</label><input id="first" required maxlength="60" placeholder="Ismingiz"></div><div class="field"><label for="last">Familiya</label><input id="last" required maxlength="60" placeholder="Familiyangiz"></div></div><div class="field"><label for="phone">Telefon raqami</label><input id="phone" required placeholder="+998 90 123 45 67"></div><div class="field"><label for="months">Kurs davomiyligi</label><select id="months"><option value="1">1 oy — tezkor yo‘nalish</option><option value="2">2 oy — muvozanatli yo‘nalish</option><option value="3">3 oy — chuqur mulohaza yo‘nalishi</option></select></div><button class="btn">Bepul o‘qishni boshlash →</button></form></div>
<div class="panel hidden" id="studyPanel"><div class="eyebrow">Shaxsiy o‘quv xonangiz</div><h2 class="section-title" id="welcome"></h2><p class="sub">Sizni akademiyamizga qabul qilganimizdan mamnunmiz. Bugun oddiy o‘quvchi sifatida emas, o‘z fikrining me’mori sifatida qadam qo‘ydingiz. Har bir savolingiz — yangi eshik.</p><div class="notice" id="duration"></div><div class="progress"><span id="progressBar"></span></div><p class="sub" id="progressText">0 / 6 dars yakunlandi</p><div id="lessons"></div><div class="notice hidden" id="finishNotice">Ajoyib! Barcha darslarni yakunladingiz. Sertifikatingizni olish uchun email manzilingizni kiriting.</div><div class="hidden" id="emailArea"><div class="field"><label>Email manzili</label><input id="email" type="email" placeholder="sizning@email.com"></div><button class="btn" id="sendCode">Tasdiqlash kodini yuborish</button><div class="field hidden" id="codeArea"><label>Emailga kelgan 6 xonali kod</label><input id="code" inputmode="numeric" maxlength="6" placeholder="123456"></div><button class="btn hidden" id="getCert">Sertifikatni olish</button></div><div id="message" class="status hidden"></div></div>
</section>
<footer><div>Bilim — hech kim tortib ololmaydigan boylik.</div><div class="founder">Asoschi: Jasur Makhamedzakirov</div></footer>
<script>
const lessons=[
{title:"1. Sokrat — o‘zingni angla",quote:"Tekshirilmagan hayot yashashga arzimaydi. — Sokratga nisbat beriladigan mashhur fikr",body:"Sokrat odamlarni tayyor javob bilan emas, savollar bilan fikrlashga undagan. Masalan, kimdir “adolat — hamma bilan bir xil muomala qilish” desa, so‘rang: hamma vaziyat bir xilmi? Kasal odamga sog‘lom odam bilan bir xil dori berish adolat bo‘ladimi? Demak, fikrni tekshirish uchun uning ma’nosini ochish va misollar bilan sinash kerak.",q:"Sokrat usulining asosiy quroli nima?",opts:["Yodlash","Savol berish va fikrni tekshirish","Boshqalarning fikrini ko‘r-ko‘rona qabul qilish"],a:1,why:"To‘g‘ri! Sokratik suhbat savollar orqali tushunchani aniqlashtiradi."},
{title:"2. Aflotun — haqiqat va ko‘rinish",quote:"G‘or timsoli: ko‘rgan narsamiz butun haqiqat bo‘lmasligi mumkin.",body:"Tasavvur qiling: odamlar umr bo‘yi devordagi soyalarni ko‘rib, ularni haqiqiy narsa deb o‘ylashgan. Tashqariga chiqqan kishi esa asl buyumlarni ko‘radi. Bu timsol bizga birinchi taassurot bilan cheklanmaslikni o‘rgatadi. Xabarni eshitsangiz, manbasini tekshiring; fikrni ko‘rsangiz, dalilini so‘rang.",q:"G‘or timsoli nimani eslatadi?",opts:["Birinchi taassurot doim to‘g‘ri","Ko‘rinish haqiqatning hammasi emas","Savollar kerak emas"],a:1,why:"To‘g‘ri! Ko‘rinayotgan narsa haqiqatning faqat bir qismi bo‘lishi mumkin."},
{title:"3. Aristotel — yaxshi hayot va fazilat",quote:"Fazilat ko‘p takrorlangan yaxshi amallar orqali shakllanadi.",body:"Aristotel uchun yaxshi hayot bir lahzalik zavq emas, balki ongli ravishda rivojlantirilgan fazilatlar hayotidir. Jasorat qo‘rquvning yo‘qligi emas: xavfni anglab, to‘g‘ri ishni qilishdir. Saxiylik hamma narsani tarqatish emas, o‘rinli paytda o‘rinli yordam berishdir. Kichik odatlar xarakterimizni quradi.",q:"Aristotelcha fazilat qanday mustahkamlanadi?",opts:["Faqat niyat qilish bilan","Yaxshi amallarni odatga aylantirish bilan","Boshqalarni tanqid qilish bilan"],a:1,why:"To‘g‘ri! Takrorlangan ongli amallar xarakter va odatni shakllantiradi."},
{title:"4. Forobiy — fozil jamiyat",quote:"Inson kamoloti boshqalar bilan hamkorlikda yuksaladi.",body:"Forobiy tasvirlagan fozil jamiyatda odamlar faqat o‘z foydasini emas, umumiy ezgulikni ham ko‘zlaydi. Jamoa kuchli bo‘lishi uchun bilim, adolat, mas’uliyat va hamkorlik zarur. Buni sinfda ham ko‘rish mumkin: har kim o‘z hissasini qo‘shsa, umumiy natija yaxshilanadi.",q:"Fozil jamiyatning muhim tayanchi qaysi?",opts:["Faqat shaxsiy manfaat","Adolat va hamkorlik","Bilimdan voz kechish"],a:1,why:"To‘g‘ri! Adolat va hamkorlik jamiyatning umumiy farovonligiga xizmat qiladi."},
{title:"5. Beruniy — dalil va qiziquvchanlik",quote:"Bilishga intilish kuzatish va tekshirish bilan kuchayadi.",body:"Beruniy turli xalqlar, tabiat va ilmiy hodisalarni o‘rganishda kuzatish, taqqoslash va dalilga tayangan. Bir da’voni eshitganingizda uch savol bering: buni kim aytyapti, qanday dalil bor, boshqa izoh bo‘lishi mumkinmi? Xato qilishdan qo‘rqmang — tekshirish bilimni mustahkamlaydi.",q:"Da’voni baholashda eng muhim yondashuv qaysi?",opts:["Faqat mashhurligiga ishonish","Dalil va kuzatishni tekshirish","Shoshilib xulosa qilish"],a:1,why:"To‘g‘ri! Dalilni tekshirish xolis fikrlashga yordam beradi."},
{title:"6. Seneka — vaqt va xotirjamlik",quote:"Vaqtimizning qadrini bilish — hayotimizning qadrini bilishdir.",body:"Stoiklar nazarida ayrim narsalar bizning nazoratimizda: qarorimiz, munosabatimiz, harakatimiz. Ayrimlari esa tashqarida: ob-havo, boshqalarning fikri, o‘tmish. Kuchimizni nazorat qila oladigan narsalarga sarflash xotirjamlikni oshiradi. Bugun 10 daqiqa nimaga sarflashingizni ongli tanlang.",q:"Stoik yondashuv nimaga e’tibor qaratadi?",opts:["Boshqalarning barcha qarorlarini boshqarish","Nazoratimizdagi tanlov va munosabatlarga","O‘tmishni o‘zgartirishga"],a:1,why:"To‘g‘ri! O‘z tanlovimiz va munosabatimiz ustida ishlash — stoik amaliyotning muhim qismi."}
];
let studentId=null,completed=[];
const $=id=>document.getElementById(id);
function showMsg(t,bad=false){$("message").textContent=t;$("message").className="status"+(bad?" error":"");}
$("registerForm").addEventListener("submit",async e=>{e.preventDefault();const b=e.submitter;b.disabled=true;try{const r=await fetch("/api/register",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({firstName:$("first").value,lastName:$("last").value,phone:$("phone").value,months:$("months").value})});const d=await r.json();if(!r.ok)throw Error(d.error);studentId=d.id;$("registerPanel").classList.add("hidden");$("studyPanel").classList.remove("hidden");$("welcome").textContent="Xush kelibsiz, "+$("first").value+"!";$("duration").textContent="Siz tanlagan kurs: "+$("months").value+" oy. Barcha 6 darsni o‘z sur’atingizda yakunlang.";renderLessons();$("studyPanel").scrollIntoView({behavior:"smooth"});}catch(err){alert(err.message)}finally{b.disabled=false}});
function renderLessons(){$("lessons").innerHTML="";lessons.forEach((l,i)=>{const div=document.createElement("div");div.className="lesson";div.innerHTML=`<h3>${l.title} ${completed.includes(i)?"✓":""}</h3><p><em>${l.quote}</em></p><p>${l.body}</p><div class="quiz"><strong>${l.q}</strong>${l.opts.map((o,j)=>`<label><input type="radio" name="q${i}" value="${j}"> ${o}</label>`).join("")}<button class="btn" data-lesson="${i}" ${completed.includes(i)?"disabled":""}>${completed.includes(i)?"Dars yakunlandi":"Javobni tekshirish"}</button><p id="feedback${i}"></p></div>`;$("lessons").appendChild(div)});document.querySelectorAll("[data-lesson]").forEach(btn=>btn.addEventListener("click",()=>finishLesson(Number(btn.dataset.lesson))));updateProgress()}
async function finishLesson(i){const selected=document.querySelector(`input[name="q${i}"]:checked`);if(!selected){$("feedback"+i).textContent="Avval javobni tanlang.";return}if(Number(selected.value)!==lessons[i].a){$("feedback"+i).textContent="Yana bir bor o‘ylab ko‘ring. Dars matnini qayta o‘qing.";return}try{const r=await fetch("/api/progress",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:studentId,lesson:i})});const d=await r.json();if(!r.ok)throw Error(d.error);completed=d.completed;$("feedback"+i).textContent=lessons[i].why;renderLessons()}catch(e){showMsg(e.message,true)}}
function updateProgress(){const n=completed.length;$("progressBar").style.width=(n/6*100)+"%";$("progressText").textContent=n+" / 6 dars yakunlandi";if(n===6){$("finishNotice").classList.remove("hidden");$("emailArea").classList.remove("hidden")}}
$("sendCode").onclick=async()=>{try{const r=await fetch("/api/email/request",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:studentId,email:$("email").value})});const d=await r.json();if(!r.ok)throw Error(d.error);$("codeArea").classList.remove("hidden");$("getCert").classList.remove("hidden");showMsg(d.message)}catch(e){showMsg(e.message,true)}};
$("getCert").onclick=async()=>{try{const r=await fetch("/api/certificate",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({id:studentId,code:$("code").value})});const d=await r.json();if(!r.ok)throw Error(d.error);showMsg(d.message+" Sertifikat № "+d.certificateNo)}catch(e){showMsg(e.message,true)}};
</script></body></html>
